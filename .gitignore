# ---- Unity generated: NEVER commit these ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# *.meta files MUST be committed, so nothing here may ignore them
!/[Aa]ssets/**/*.meta

# ---- IDE and autogenerated project files ----
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- builds ----
*.apk
*.aab
*.unitypackage
*.app

# ---- crash and OS junk ----
sysinfo.txt
.DS_Store
Thumbs.db

# ---- the plaintext answer key for the secret files must never ship ----
/Secrets/NUMBERS_A.txt
