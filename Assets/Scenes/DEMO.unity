  gapFrames: 6
  sentences:
  - text: 'I see. '
    tint: {r: 0.5018867, g: 0.38760555, b: 0.30965462, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "Whenever you think you've had\nenough of [[, you can leave \nthe house.  "
    tint: {r: 0.5018867, g: 0.38760555, b: 0.41960785, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'I will always be waiting for you. '
    tint: {r: 0.5018867, g: 0.38760555, b: 0.62352943, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'I feel something when i''m with

      you.

      But when you do leave,
      please,'
    tint: {r: 0.5018867, g: 0.38760555, b: 1, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: Make sure you come back.
    tint: {r: 1, g: 1, b: 1, a: 1}
    fps: 24
    autoAdvanceAfter: 0
