  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SentenceBuilder
  responseGroup: {fileID: 0}
  isRevealed: 0
  activateOnTrigger: 0
  finishedRendering: 0
  nextGroup: {fileID: 1907801516}
  gapFrames: 6
  sentences:
  - text: "All of this, \nwas made by me, well, everything\nexcept the red flowers,
      modeling flowers\nis hard. "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'What i love the most about this room

      are the vines, i could draw
      them

      any way i wanted! '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'Look around if you''d like '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'Im sure there are some secrets here

      as well. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
  persistent: 0
