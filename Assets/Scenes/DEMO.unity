  gapFrames: 6
  sentences:
  - text: 'Take this blue gnome here, for demonstration. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'What purpose does he have?  '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: Is it just a decoration?
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: Is it just vanity?
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: Can this gnome feel?
    tint: {r: 1, g: 0.70389724, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: Can this gnome breathe?
    tint: {r: 1, g: 0.7019608, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
