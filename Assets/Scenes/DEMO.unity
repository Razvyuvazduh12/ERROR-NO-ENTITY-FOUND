  finishedRendering: 0
  nextGroup: {fileID: 493323757}
  gapFrames: 6
  sentences:
  - text: 'I don''t know why, but i have the ability

      to hear as well, and
      i can hear this song. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "Despite how simple it is, It makes me \nfeel something "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'Calmess maybe, it''s short though '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "But don't worry, i made sure to compose \nother songs as well! "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
  persistent: 0
