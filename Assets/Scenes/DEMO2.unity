  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SentenceBuilder
  responseGroup: {fileID: 0}
  isRevealed: 0
  activateOnTrigger: 0
  finishedRendering: 0
  nextGroup: {fileID: 1135432709}
  gapFrames: 6
  sentences:
  - text: 'What i just felt is called a dopamine spike. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'Before we go to the next room, let me tell you a story.

'
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "Imagine a kid that has never eaten chocolate his entire \nlife."
    tint: {r: 1, g: 0, b: 0.4959941, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "He tasted sweets, but never cacao, he saw all his \nfriends eat it, but
      when he wanted to eat it as well,"
    tint: {r: 1, g: 0, b: 0.4959941, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: His mom would say 'No, chocolate is bad for you.'
    tint: {r: 1, g: 0, b: 0.4959941, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: '''Why was chocolate bad for me?'' The kid wondered.'
    tint: {r: 1, g: 0, b: 0.4959941, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
  persistent: 0
  sequentialReveal: 1
  priority: 0
  debugClicks: 0
  activateAfterSeconds: 0
  isTrigger: 0
  triggerOnce: 1
