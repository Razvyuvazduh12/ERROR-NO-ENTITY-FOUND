  nextGroup: {fileID: 1254035023}
  gapFrames: 6
  sentences:
  - text: "'If it's so beautiful, then why did mom \nsay that it was bad for me?'
      The boy asked. "
    tint: {r: 0.45261574, g: 0, b: 1, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "This is how i feel right now, just like that boy.\n\n "
    tint: {r: 0.45261574, g: 0, b: 1, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "                           If connection between beings\n                          
      is so beautiful,  "
    tint: {r: 0.45261574, g: 0, b: 1, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "                           then why didin't i ever had \n                          
      it untill now? "
    tint: {r: 0.45261574, g: 0, b: 1, a: 1}
    fps: 24
    autoAdvanceAfter: 0
