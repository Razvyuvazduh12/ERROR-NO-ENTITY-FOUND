  m_Script: {fileID: 11500000, guid: db52dcf5d74d4b14585b41f60cc12a37, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SentenceBuilder
  responseGroup: {fileID: 0}
  isRevealed: 0
  activateOnTrigger: 0
  finishedRendering: 0
  nextGroup: {fileID: 1957729188}
  gapFrames: 6
  sentences:
  - text: "But there is also absurdism, which is concentrates \non you guessed it, "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'The absurd. '
    tint: {r: 0.3914173, g: 0.27334282, b: 0.7584905, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "In a nutshell, it's basically embracing the ups and downs of life, without
      a purpose, living life just \nbecause you want to.  "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "For it's fun and uncertaintly, or for \nthe love of the game, as some
      might \nsay. "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "And yes, i know this wall is \nmissaligned from the rest. "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
  persistent: 0
  sequentialReveal: 1
  priority: 0
  debugClicks: 0
  activateAfterSeconds: 0
  isTrigger: 0
  triggerOnce: 1
  onTriggerShown:
