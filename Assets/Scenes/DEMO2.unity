  gapFrames: 6
  sentences:
  - text: 'Yet you do this every single day, right?

      Social media, vices and
      more. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'The only difference is that those bring you '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "Pleasure.\n "
    tint: {r: 1, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'That time wasn''t wasted. i came to a realization. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "Time doing nothing is much better than eating \nyour life away. "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
