  sentences:
  - text: "I've come to find out that music \nisin't necesarily heard "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'It''s felt, in the heart. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'and in the soul. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "That's why music \ncan explain "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'what words can''t. '
    tint: {r: 1, g: 0.5468963, b: 0, a: 1}
    fps: 24
