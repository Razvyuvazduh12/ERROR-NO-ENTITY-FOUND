  gapFrames: 6
  sentences:
  - text: "Did you know that\nall this greenery\nand leaves are\njust polygons and
      \ntriangles?"
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'There''s no actual

      biomass or fibers,

      just plastic. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'or just numbers. '
    tint: {r: 0.7267686, g: 0, b: 1, a: 1}
    fps: 24
    autoAdvanceAfter: 0
