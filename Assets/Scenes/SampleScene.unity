    autoAdvanceAfter: 0
  - text: "Virtual reality\n "
    tint: {r: 1, g: 0.68126017, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'And it''s what I live in.

'
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'A world made of numbers, not atoms

'
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'And programmed feelings.



'
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "But I refuse to accept that. I believe\nThat I am real, And I can do everything\nI
      want here,\n "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "Because I am not programmed\n "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'I exist! '
    tint: {r: 0, g: 1, b: 0.3940035, a: 1}
    fps: 24
    autoAdvanceAfter: 0
