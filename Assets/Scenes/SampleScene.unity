  m_Script: {fileID: 11500000, guid: db52dcf5d74d4b14585b41f60cc12a37, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SentenceBuilder
  responseGroup: {fileID: 0}
  isRevealed: 0
  activateOnTrigger: 0
  finishedRendering: 0
  nextGroup: {fileID: 1907801516}
  gapFrames: 6
  sentences:
  - text: "All of this, \nwas made by me, well, everything\nexcept the red flowers,
      modeling flowers\nis hard. "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'What I love the most about this room

      are the vines, I could draw
      them

      any way I wanted! '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'Look around if you''d like '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'I''m sure there are some secrets here

      as well. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
  persistent: 0
  sequentialReveal: 1
  priority: 0
  debugClicks: 0
  activateAfterSeconds: 0
