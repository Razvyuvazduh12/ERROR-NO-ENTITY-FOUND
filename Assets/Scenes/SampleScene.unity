  m_Script: {fileID: 11500000, guid: db52dcf5d74d4b14585b41f60cc12a37, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SentenceBuilder
  responseGroup: {fileID: 0}
  isRevealed: 0
  activateOnTrigger: 0
  finishedRendering: 0
  nextGroup: {fileID: 269977235}
  gapFrames: 6
  sentences:
  - text: "Humans are meant to have a reason to wake up \ntomorrow for, if they didn't,
      we would be extinct \nby now. "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'In any era of humanity, they

      had a reason to be there, '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "In the prehistoric era, it was\nto provide their tribe with \nfood "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'In the middle ages, it was to

      make a living, and maybe become

      rich
      one day '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "And it's the same today, to \nprovide for your family, or \nto discover
      something new, "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'Curiosity. '
    tint: {r: 0.15018933, g: 0.8490566, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
  persistent: 0
  sequentialReveal: 1
  priority: 0
  debugClicks: 0
  activateAfterSeconds: 0
  isTrigger: 0
  triggerOnce: 1
  onTriggerShown:
    m_PersistentCalls:
      m_Calls: []
  leaveBranch: 0
  descenderChars: gjpqyx
  spriteSheetPath_CAPS: Letters/fontcaps
  spriteSheetPath_lower: Letters/fontLower
