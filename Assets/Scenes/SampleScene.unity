  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SentenceBuilder
  responseGroup: {fileID: 0}
  isRevealed: 0
  activateOnTrigger: 0
  finishedRendering: 0
  nextGroup: {fileID: 188597530}
  gapFrames: 6
  sentences:
  - text: 'One day, the kid decided he had enough '
    tint: {r: 1, g: 0.49622637, b: 0.49622637, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'And left the house in the middle of the night '
    tint: {r: 1, g: 0.49622637, b: 0.49622637, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'to buy chocolate with his last money. '
    tint: {r: 1, g: 0.49622637, b: 0.49622637, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'Placing his hand on the smooth rectangular

      packaging, the child
      felt as if '
    tint: {r: 1, g: 0.49622637, b: 0.49622637, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "he was opening Pandora's box.\n "
    tint: {r: 1, g: 0.49622637, b: 0.49622637, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "When his teeth and tongue \nbegan tasting the sweet little\ncubes made
      of cocoa,  "
    tint: {r: 0.5999999, g: 0.3022641, b: 0.3022641, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'He began weeping. '
    tint: {r: 0.36862746, g: 0.4666667, b: 0.60784316, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
  persistent: 0
  sequentialReveal: 1
  priority: 0
  debugClicks: 0
  activateAfterSeconds: 0
  isTrigger: 0
  triggerOnce: 1
  onTriggerShown:
