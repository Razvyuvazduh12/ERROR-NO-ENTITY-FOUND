  gapFrames: 6
  sentences:
  - text: 'I don''t know why, but I have the ability

      to hear as well, and
      I can hear this song. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "Despite how simple it is, It makes me \nfeel something "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'Calmness maybe, it''s short though '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "But don't worry, I made sure to compose \nother songs as well! "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
