  nextGroup: {fileID: 1230080320}
  gapFrames: 6
  sentences:
  - text: 'And before you ask, I don''t see games as wasted time,

      especially
      if you enjoy them. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'It would be an insult to yourself to call something you enjoy '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'as wasted time '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'I like video games myself, Not just like, I love them. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
