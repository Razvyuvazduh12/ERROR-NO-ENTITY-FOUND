  m_Script: {fileID: 11500000, guid: db52dcf5d74d4b14585b41f60cc12a37, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SentenceBuilder
  responseGroup: {fileID: 0}
  isRevealed: 0
