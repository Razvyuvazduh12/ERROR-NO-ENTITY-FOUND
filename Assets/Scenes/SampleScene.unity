  m_Script: {fileID: 11500000, guid: db52dcf5d74d4b14585b41f60cc12a37, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SentenceBuilder
  responseGroup: {fileID: 0}
  isRevealed: 0
  activateOnTrigger: 0
  finishedRendering: 0
  nextGroup: {fileID: 443096284}
  gapFrames: 6
  sentences:
  - text: "It can be an elephant, a toy \nroom, a bathroom or a whole other\nuniverse! "
    tint: {r: 1, g: 0.49823612, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'Heh, I don''t know how to model a

      damn sofa chair and I expect
      to make

      a universe? '
    tint: {r: 1, g: 0.49823612, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'How foolish of me. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'Or is it? maybe I''m foreshadowing, who

      knows? '
    tint: {r: 1, g: 0.49803922, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "    Before you go, there's a special\n      book in one of these\n        
      bookshelves, you\n           might want to\n            check it out. "
    tint: {r: 1, g: 0.49803922, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
  persistent: 0
  sequentialReveal: 1
