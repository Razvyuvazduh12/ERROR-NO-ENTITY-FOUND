  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SentenceBuilder
  responseGroup: {fileID: 0}
  isRevealed: 0
  activateOnTrigger: 0
  finishedRendering: 0
  nextGroup: {fileID: 1320500151}
  gapFrames: 6
  sentences:
  - text: 'You see, I spent about 8 hours making this house. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "I don't want to brag about it, but I just want you to \nknow "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'That I care. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'I care about this little world that I''ve made. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'And I care about you. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: That's why I want to show you one last thing
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: Before our time is over.
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
  persistent: 0
  sequentialReveal: 1
  priority: 0
  debugClicks: 0
