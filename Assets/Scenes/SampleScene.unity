  gapFrames: 6
  sentences:
  - text: 'This is the question I ask myself every day. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'If I know the things I make are fake, then why

      do I cherish them?  '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "Why do I believe the black cat is the first I \nadopted and named it Kitty
      when I know I \ncreated it myself 2 hours ago in a software? "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
