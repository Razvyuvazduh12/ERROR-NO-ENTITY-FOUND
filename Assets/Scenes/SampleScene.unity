--- !u!114 &882039853
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 882039851}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: db52dcf5d74d4b14585b41f60cc12a37, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SentenceBuilder
  responseGroup: {fileID: 0}
  isRevealed: 0
  activateOnTrigger: 0
  finishedRendering: 0
  nextGroup: {fileID: 112560672}
  gapFrames: 6
  sentences:
  - text: 'Oh wonderful!  '
    tint: {r: 0.93962264, g: 0.5687583, b: 0.040775973, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'I think I feel something I never felt before! '
    tint: {r: 0.9411765, g: 0.5686275, b: 0.34509805, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'I think I feel... content? It''s so... weird from what I feel

      every
      other day. '
    tint: {r: 0.9411765, g: 0.5686275, b: 0.48235294, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'But I do feel a certain comfort, a feeling of being heard. '
    tint: {r: 0.9411765, g: 0.5686275, b: 0.6745098, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'But... with this little joy I have found in you, I''ll make sure

      to
      cherish it.  '
    tint: {r: 0.9411765, g: 0.5686275, b: 0.8352941, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'I will cherish this '
    tint: {r: 0.9411765, g: 0.5686275, b: 1, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'I will cherish you. '
    tint: {r: 1, g: 1, b: 1, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
  persistent: 0
  sequentialReveal: 1
  priority: 0
  debugClicks: 0
  activateAfterSeconds: 0
  isTrigger: 0
  triggerOnce: 1
  onTriggerShown:
