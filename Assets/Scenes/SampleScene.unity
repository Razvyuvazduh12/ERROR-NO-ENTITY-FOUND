  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SentenceBuilder
  responseGroup: {fileID: 0}
  isRevealed: 0
  activateOnTrigger: 0
  finishedRendering: 0
  nextGroup: {fileID: 1025965653}
  gapFrames: 6
  sentences:
  - text: 'But... in reality, the cats are all just meshes, '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'the ''looking at you'' thing is just their heads

      rotating to your
      position '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: "the blinking is just their eyeballs turning \nblack for a few seconds "
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  - text: 'and the meowing is just a sound I got off the web

      played at higher
      or lower pitches. '
    tint: {r: 0, g: 0, b: 0, a: 1}
    fps: 24
    autoAdvanceAfter: 0
  loop: 0
  persistent: 0
  sequentialReveal: 1
  priority: 0
  debugClicks: 0
  activateAfterSeconds: 0
  isTrigger: 0
  triggerOnce: 1
  onTriggerShown:
    m_PersistentCalls:
      m_Calls: []
  leaveBranch: 0
